# docker compose용 환경변수 예시. 이 파일을 .env로 복사해 채운다(.env는 저장소에 넣지 않는다).
APP_PASSWORD=                 # 접속 비밀번호(10자 이상). 비우면 잠금 없음 — 사내망 안에서만
LLM_PROVIDER=anthropic        # anthropic | openai | gemini | bedrock | vertex | none
ANTHROPIC_API_KEY=            # 공용 키를 서버에 둘 때만. 비우면 접속자가 설정 화면에 자기 키를 넣는다
ANTHROPIC_BASE_URL=           # 사내 게이트웨이·프록시가 있을 때만
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=                    # 비우면 공급자 기본 후보 순
LLM_EFFORT=                   # low | medium | high (비우면 모델 기본)
LLM_DAILY_BUDGET_USD=         # 하루 AI 사용 상한(추정 달러). 넘으면 그날 호출을 멈춘다. 비우면 제한 없음
DEPT_HEAD=                    # 답변자료 【확인】 줄 기본값(설정 화면에서 저장하면 그 값이 우선)
DEPT_PHONE=
HTTPS_PROXY=                  # 바깥으로 나가는 프록시가 있을 때
LITESTREAM_REPLICA_URL=       # 기록 DB 복제 대상(선택): s3://버킷/history · gcs://버킷/history · abs://계정/컨테이너/history
LITESTREAM_ENDPOINT=          # S3 호환(네이버 클라우드 Object Storage·MinIO)일 때만
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
APP_BACKUP_KEEP=10            # 서버 안 자동 사본 보존 개수
APP_ADMIN_PASSWORD=           # 백업 내려받기·복원·전체 삭제에만 쓰는 관리자 비밀번호(선택). 비우면 APP_PASSWORD로 재확인
APP_NO_CDN=                   # 1이면 외부 폰트(jsDelivr) 불러오기를 끈다(인터넷이 막힌 사내망)
APP_DB_ON_CORRUPT=            # stop이면 기록 DB 손상 시 빈 기록으로 뜨지 않고 멈춘다(복제가 켜진 서버는 자동 stop)
STREAMLIT_ERROR_DETAILS=      # 화면에 보이는 오류 상세: type(기본, 종류만) | full(개발용)
STREAMLIT_SERVER_BASE_URL_PATH=   # 경로 접두가 붙는 리버스 프록시 뒤(예: ebs → https://intranet/ebs/)
